{
  "manifest_version": 3,
  "name": "AskTheMove: Analyse this puzzle",
  "short_name": "AskTheMove",
  "version": "0.1.0",
  "description": "One tap sends the Chess.com puzzle on screen to your own AskTheMove board: draw on it, test your line, check it.",
  "homepage_url": "https://askthemove.online/puzzleanalyzr/",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/puzzles*", "https://www.chess.com/daily-chess-puzzle*"],
      "exclude_matches": ["https://www.chess.com/puzzles/rush*", "https://www.chess.com/puzzles/battle*"],
      "js": ["reader.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "extension@askthemove.online", "strict_min_version": "128.0" } }
}
