{
  "name": "askthemove-site",
  "version": "0.1.0",
  "private": true,
  "description": "AskTheMove public beta waitlist site (Cloudflare Pages + Pages Functions + D1).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node extension/make-bookmarklet.mjs && node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "dev": "wrangler pages dev",
    "test": "node --test --no-warnings=ExperimentalWarning \"test/*.test.js\"",
    "db:migrate:local": "wrangler d1 migrations apply askthemove-waitlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply askthemove-waitlist --remote",
    "delete-signup": "node scripts/delete-signup.mjs",
    "build:betapp": "node scripts/build-betapp.mjs",
    "deploy": "node scripts/build.mjs --check && node scripts/build-betapp.mjs && wrangler pages deploy --branch main",
    "check:pens": "node scripts/check-pens.mjs"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "wrangler": "4.136.3"
  }
}
