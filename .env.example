# Native Stockfish is installed on the server, never downloaded by the browser.
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
HOST=127.0.0.1
PORT=8770
CHESSLAB_DB=./data/chesslab.sqlite
# Enable only behind HTTPS when deploying; local HTTP development needs 0.
COOKIE_SECURE=0

# Private Sites backend: use a separate database and HTTPS origin.
# Set both PUBLIC_ORIGIN and CHESSLAB_BACKEND_SECRET (64 hex characters), or neither.
# PUBLIC_ORIGIN=https://your-private-site.example
# CHESSLAB_BACKEND_SECRET=generate-with-openssl-rand-hex-32
