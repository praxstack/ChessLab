# Native Stockfish is installed on the server, never downloaded by the browser.
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
HOST=127.0.0.1
PORT=8770
CHESSLAB_DB=./data/chesslab.sqlite
# Enable only behind HTTPS when deploying; local HTTP development needs 0.
COOKIE_SECURE=0

# Private Sites backend: use a separate database and HTTPS origin.
# Set both PUBLIC_ORIGIN and CHESSLAB_BACKEND_SECRET (64 hex characters), or neither.
# PUBLIC_ORIGIN=https://your-private-site.example
# CHESSLAB_BACKEND_SECRET=generate-with-openssl-rand-hex-32

# Hosted private beta (see docs/deploy-beta.md). Leave unset for local use.
# APP_ORIGIN=https://app.example.com
# TRUST_PROXY=1
# BETA_INVITE_CODES=first-cohort-code,second-cohort-code
# Codes whose accounts may use your Claude key on a hosted server; each also admits sign-up.
# COACH_AI_INVITE_CODES=asha-5c1e9a07d3b2,ravi-8f40b6e2a91c
# SERVE_ARCHIVES=0

# Optional Claude explanations of engine evidence. Without a key the engine summary is used.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# COACH_AI_EFFORT=low
# COACH_AI_TIMEOUT_MS=15000
# COACH_AI_MAX_PER_HOUR=30
# COACH_AI_MAX_PER_DAY=50
# COACH_ENGINE_MOVETIME_MS=800
